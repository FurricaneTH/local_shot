# Optional local-only executables. Copy this file to .env and adjust paths.
# Never commit .env.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Optional offline transcription. Example: /opt/homebrew/bin/whisper-cli
WHISPER_CLI=
# Required only when WHISPER_CLI is set; keep the model on this computer.
WHISPER_MODEL=

