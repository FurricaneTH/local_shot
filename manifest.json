{
  "manifest_version": 3,
  "name": "Öğrenerek Ad Blocker",
  "version": "1.0.0",
  "description": "Reklam isteklerini engelleyen ve yaygın reklam alanlarını gizleyen temel Chrome eklentisi.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Öğrenerek Ad Blocker",
    "default_popup": "popup.html"
  }
}
